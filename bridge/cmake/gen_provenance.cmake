# Regenerate build_provenance.h on every build. Captures the exact source the
# .so was built from, so a deployed bridge can be matched to a commit and we
# never again waste a verification cycle on a stale/ambiguous binary.
#
# Invoked as: cmake -DOUT=<path> -DSRCDIR=<repo/bridge> -P gen_provenance.cmake

if(NOT DEFINED OUT OR NOT DEFINED SRCDIR)
  message(FATAL_ERROR "gen_provenance.cmake requires -DOUT and -DSRCDIR")
endif()

set(GIT_SHA "unknown")
set(GIT_DIRTY "unknown")
set(GIT_BRANCH "unknown")

# ck-yjrp: CHECK WHETHER GIT ACTUALLY ANSWERED.
#
# These three calls used ERROR_QUIET with no RESULT_VARIABLE. On a tree with no
# .git — a `git archive` export, which is how CI and the two-party blind
# rebuild get their source — every command fails, OUTPUT_VARIABLE is set to the
# EMPTY STRING, and that OVERWRITES the "unknown" defaults above. Then
# `if(GIT_STATUS STREQUAL "")` reads the failure as proof of a clean tree.
#
# So the worst case produced the most reassuring possible answer: GIT_SHA ""
# and GIT_DIRTY "clean". A build whose provenance is entirely unknown claimed
# to be a clean build. Found by ck-zgh4 on a discarded archive build.
#
# The rule this breaks is the one the rest of this system is built on: a
# measurement that FAILS must not return a VALUE. Absence gets its own
# spelling, and "we could not ask" is not "we asked and the answer was fine".
find_program(GIT_EXE git)
if(GIT_EXE)
  execute_process(COMMAND ${GIT_EXE} -C ${SRCDIR} rev-parse --short=12 HEAD
    OUTPUT_VARIABLE GIT_SHA_OUT RESULT_VARIABLE GIT_SHA_RC
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(GIT_SHA_RC EQUAL 0 AND NOT GIT_SHA_OUT STREQUAL "")
    set(GIT_SHA "${GIT_SHA_OUT}")
  endif()

  execute_process(COMMAND ${GIT_EXE} -C ${SRCDIR} rev-parse --abbrev-ref HEAD
    OUTPUT_VARIABLE GIT_BRANCH_OUT RESULT_VARIABLE GIT_BRANCH_RC
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(GIT_BRANCH_RC EQUAL 0 AND NOT GIT_BRANCH_OUT STREQUAL "")
    set(GIT_BRANCH "${GIT_BRANCH_OUT}")
  endif()

  # GIT_DIRTY is derived ONLY when the status command SUCCEEDED. An empty
  # output means "no modifications" only if git was able to look; otherwise it
  # means nothing at all, and must stay "unknown".
  execute_process(COMMAND ${GIT_EXE} -C ${SRCDIR} status --porcelain
    OUTPUT_VARIABLE GIT_STATUS RESULT_VARIABLE GIT_STATUS_RC
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(GIT_STATUS_RC EQUAL 0)
    if(GIT_STATUS STREQUAL "")
      set(GIT_DIRTY "clean")
    else()
      set(GIT_DIRTY "dirty")
    endif()
  endif()
endif()

# Hash the offset header — the single most important input. If two builds
# disagree on this, they disagree on every address.
set(OFFSETS_MD5 "unknown")
set(OFFSETS_HEADER "${SRCDIR}/../re/offsets/ck3_offsets.h")
if(EXISTS "${OFFSETS_HEADER}")
  file(MD5 "${OFFSETS_HEADER}" OFFSETS_MD5)
endif()

string(TIMESTAMP BUILD_TIME "%Y-%m-%dT%H:%M:%S" UTC)

set(CONTENT "// AUTO-GENERATED by gen_provenance.cmake — do not edit.
#pragma once
namespace bridge_provenance {
constexpr const char* GIT_SHA      = \"${GIT_SHA}\";
constexpr const char* GIT_BRANCH   = \"${GIT_BRANCH}\";
constexpr const char* GIT_DIRTY    = \"${GIT_DIRTY}\";
constexpr const char* OFFSETS_MD5  = \"${OFFSETS_MD5}\";
constexpr const char* BUILD_TIME   = \"${BUILD_TIME}\";
}
")

# Only rewrite if changed, so we don't force a relink when nothing moved.
set(EXISTING "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" EXISTING)
endif()
if(NOT EXISTING STREQUAL CONTENT)
  file(WRITE "${OUT}" "${CONTENT}")
  message(STATUS "build_provenance.h: ${GIT_SHA} (${GIT_DIRTY}) offsets=${OFFSETS_MD5}")
endif()
